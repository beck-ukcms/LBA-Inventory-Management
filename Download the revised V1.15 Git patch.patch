-    itemId: '',
-    formNumber: '',
-    serialNumber: '',
-    transactionType: transactionType,
-    quantityChange: 0,
-    unit: 'Session',
-    sessionId: sessionId,
-    source: SESSION_PROCESSING_SOURCE,
-    notes: notes
