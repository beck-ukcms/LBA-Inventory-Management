+<section id="catalog-maintenance-screen" class="screen">
+ <div class="section-title"><div><h2>Catalog Maintenance</h2><p class="muted">Edit active and inactive PT and Paper products.</p></div><button class="btn secondary" onclick="showScreen('admin-screen')">Back</button></div>
+ <div class="panel"><div class="actions"><button id="cat-pt-tab" class="btn" onclick="showCatalogType('pt')">Pulltabs</button><button id="cat-paper-tab" class="btn secondary" onclick="showCatalogType('paper')">Paper</button></div><div id="catalog-status" class="status"></div></div>
+ <div id="cat-pt-panel" class="panel"><label>Game / Form</label><input id="cat-pt-search" list="cat-pt-list" autocomplete="off" onchange="loadCatalogPT()"><datalist id="cat-pt-list"></datalist><div id="cat-pt-fields" class="form-grid"></div><button class="btn" onclick="saveCatalogPT()">Save PT Game</button></div>
+ <div id="cat-paper-panel" class="panel hidden"><label>Paper Type</label><input id="cat-paper-search" list="cat-paper-list" autocomplete="off" onchange="loadCatalogPaper()"><datalist id="cat-paper-list"></datalist><div id="cat-paper-fields" class="form-grid"></div><button class="btn" onclick="saveCatalogPaper()">Save Paper Type</button></div>
+</section>
+<script>
+let CATALOG_DATA={pt:[],paper:[],gameTypes:[]},CAT_PT=null,CAT_PAPER=null;
+async function openCatalogMaintenance(){showScreen('catalog-maintenance-screen');CATALOG_DATA=await server('getCatalogMaintenanceData',ADMIN_TOKEN);$('cat-pt-list').innerHTML=CATALOG_DATA.pt.map(x=>`<option value="${escapeHtml(x.label)}"></option>`).join('');$('cat-paper-list').innerHTML=CATALOG_DATA.paper.map(x=>`<option value="${escapeHtml(x.label)}"></option>`).join('');showCatalogType('pt')}
+function showCatalogType(t){$('cat-pt-panel').classList.toggle('hidden',t!=='pt');$('cat-paper-panel').classList.toggle('hidden',t!=='paper');$('cat-pt-tab').className=t==='pt'?'btn':'btn secondary';$('cat-paper-tab').className=t==='paper'?'btn':'btn secondary'}
+function field(id,label,value,type='text'){return `<div><label for="${id}">${label}</label><input id="${id}" type="${type}" value="${escapeHtml(value)}"></div>`}
+function loadCatalogPT(){CAT_PT=CATALOG_DATA.pt.find(x=>x.label===$('cat-pt-search').value)||null;if(!CAT_PT)return;$('cat-pt-fields').innerHTML=field('cpt-name','Game Name',CAT_PT.gameName)+field('cpt-type','Game Type',CAT_PT.gameType)+field('cpt-form','Primary Form',CAT_PT.primaryFormNumber)+field('cpt-alt','Alternate Forms',CAT_PT.alternateFormNumbers)+field('cpt-order','Display Order',CAT_PT.displayOrder,'number')+field('cpt-cards','Cards per Deal',CAT_PT.cardsPerDeal,'number')+field('cpt-case','Deals per Case',CAT_PT.dealsPerCase,'number')+field('cpt-price','Price per Card',CAT_PT.pricePerCard,'number')+field('cpt-payout','Payout per Deal',CAT_PT.payoutPerDeal,'number')+field('cpt-cost','Manufacturer Cost per Deal',CAT_PT.manufacturerCostPerDeal,'number')+field('cpt-target','Target On Hand',CAT_PT.targetOnHand,'number')+field('cpt-bundled','Target Bundled',CAT_PT.targetBundled,'number')+field('cpt-notes','Notes',CAT_PT.notes)+`<div><label><input id="cpt-active" type="checkbox" ${CAT_PT.active?'checked':''}> Active</label></div>`}
+async function saveCatalogPT(){if(!CAT_PT)return;const v=id=>$(id).value;await server('updatePTGame',ADMIN_TOKEN,{gameId:CAT_PT.gameId,gameName:v('cpt-name'),gameType:v('cpt-type'),primaryFormNumber:v('cpt-form'),alternateFormNumbers:v('cpt-alt'),displayOrder:v('cpt-order'),cardsPerDeal:v('cpt-cards'),dealsPerCase:v('cpt-case'),pricePerCard:v('cpt-price'),payoutPerDeal:v('cpt-payout'),manufacturerCostPerDeal:v('cpt-cost'),targetOnHand:v('cpt-target'),targetBundled:v('cpt-bundled'),notes:v('cpt-notes'),active:$('cpt-active').checked});setStatus('catalog-status','PT game saved.')}
+function loadCatalogPaper(){CAT_PAPER=CATALOG_DATA.paper.find(x=>x.label===$('cat-paper-search').value)||null;if(!CAT_PAPER)return;$('cat-paper-fields').innerHTML=field('cp-short','Short Name',CAT_PAPER.shortName)+field('cp-desc','Description',CAT_PAPER.description)+field('cp-order','Display Order',CAT_PAPER.displayOrder,'number')+field('cp-packbox','Packs per Box',CAT_PAPER.packsPerBox,'number')+field('cp-boxcase','Boxes per Case',CAT_PAPER.boxesPerCase,'number')+field('cp-cost','Manufacturer Cost per Case',CAT_PAPER.manufacturerCostPerCase,'number')+field('cp-price','Sales Price per Pack',CAT_PAPER.salesPricePerPack,'number')+field('cp-target','Target On Hand',CAT_PAPER.targetOnHand,'number')+field('cp-notes','Notes',CAT_PAPER.notes)+`<div><label><input id="cp-active" type="checkbox" ${CAT_PAPER.active?'checked':''}> Active</label></div>`}
+async function saveCatalogPaper(){if(!CAT_PAPER)return;const v=id=>$(id).value;await server('updatePaperType',ADMIN_TOKEN,{paperId:CAT_PAPER.paperId,shortName:v('cp-short'),description:v('cp-desc'),displayOrder:v('cp-order'),packsPerBox:v('cp-packbox'),boxesPerCase:v('cp-boxcase'),manufacturerCostPerCase:v('cp-cost'),salesPricePerPack:v('cp-price'),targetOnHand:v('cp-target'),notes:v('cp-notes'),active:$('cp-active').checked});setStatus('catalog-status','Paper type saved.')}
+</script>
