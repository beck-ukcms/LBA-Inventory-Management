+<div id="dashboard-order-modal" class="modal"><div class="modal-card"><button class="close" type="button" onclick="closeModal('dashboard-order-modal')">×</button><h2>Review Order</h2><div id="dashboard-order-review"></div><label for="dashboard-admin-code">Administrative code</label><input id="dashboard-admin-code" type="password" inputmode="numeric"><div id="dashboard-order-status" class="status"></div><div class="actions"><button class="btn" type="button" onclick="submitDashboardOrder()">Place Order</button><button class="btn secondary" type="button" onclick="closeModal('dashboard-order-modal')">Cancel</button></div></div></div>
+<script>
+let DASHBOARD_DATA={pt:[],paper:[]};
+async function openDashboard(){showScreen('dashboard-screen');clearStatus('dashboard-status');try{DASHBOARD_DATA=await server('getDashboardData');renderDashboard();}catch(e){setStatus('dashboard-status',e.message,true)}}
+function renderDashboard(){
+ $('dashboard-pt-rows').innerHTML=DASHBOARD_DATA.pt.map(x=>`<tr><td>${escapeHtml(x.label)}</td><td>${x.onHand} (${x.targetOnHand})</td><td>${x.bundled} (${x.targetBundled})</td><td>${x.soldPerWeek.toFixed(1)}</td><td>$${x.netProfitPerDollar.toFixed(2)}</td><td><input class="dashboard-pt-order" data-id="${escapeHtml(x.gameId)}" type="number" min="0" step="1"></td></tr>`).join('');
+ $('dashboard-paper-rows').innerHTML=DASHBOARD_DATA.paper.map(x=>`<tr><td>${escapeHtml(x.label)}</td><td>${x.packsOnHand} (${x.targetOnHand})</td><td>${x.soldPerWeek.toFixed(1)}</td><td>$${x.netProfitPerDollar.toFixed(2)}</td><td><input class="dashboard-paper-order" data-id="${escapeHtml(x.paperId)}" type="number" min="0" step="1"></td></tr>`).join('');
+}
+function collectDashboardOrder(){return{pt:[...document.querySelectorAll('.dashboard-pt-order')].filter(x=>Number(x.value)>0).map(x=>({gameId:x.dataset.id,quantity:Number(x.value)})),paper:[...document.querySelectorAll('.dashboard-paper-order')].filter(x=>Number(x.value)>0).map(x=>({paperId:x.dataset.id,quantity:Number(x.value)}))}}
+function reviewDashboardOrder(){const o=collectDashboardOrder();if(!o.pt.length&&!o.paper.length){setStatus('dashboard-status','Enter at least one order quantity.',true);return}const lines=[];o.pt.forEach(line=>{const x=DASHBOARD_DATA.pt.find(v=>v.gameId===line.gameId);lines.push(`${x.label}: ${line.quantity} deal(s)`)});o.paper.forEach(line=>{const x=DASHBOARD_DATA.paper.find(v=>v.paperId===line.paperId);lines.push(`${x.label}: ${line.quantity} case(s)`)});$('dashboard-order-review').innerHTML='<ul>'+lines.map(x=>`<li>${escapeHtml(x)}</li>`).join('')+'</ul>';$('dashboard-admin-code').value='';clearStatus('dashboard-order-status');openModal('dashboard-order-modal')}
+async function submitDashboardOrder(){try{const result=await server('placeDashboardOrder',$('dashboard-admin-code').value,collectDashboardOrder());closeModal('dashboard-order-modal');setStatus('dashboard-status',`Order placed: ${result.ptDeals} PT deal(s), ${result.paperCases} Paper case(s).`);await openDashboard()}catch(e){setStatus('dashboard-order-status',e.message,true)}}
+</script>
